TRITON_PATH := thirdparty/triton/src/virtio/neptune/triton

TRITON_INCLUDES := $(TRITON_PATH)
TRITON_DEFINES := TRITON_BUILD_COMMON_TRANSLATION_LAYER

CFLAGS+=$(addprefix -I,$(TRITON_INCLUDES)) $(addprefix -D,$(TRITON_DEFINES))

TRITON_SRC := \
    tritonDDI.c \
    tritonDxbc.c \
    tritonQuery.c \
    tritonResource.c \
    tritonShader.c \
    tritonState.c \
    tritonView.c \

TRITON_OBJS := $(addprefix $(BUILD_DIR)/triton/,$(addsuffix .o,$(basename $(TRITON_SRC))))

$(BUILD_DIR)/triton.a: $(TRITON_OBJS)
	$(AR) rcs $@ $^

$(BUILD_DIR)/triton/%.o: $(TRITON_PATH)/%.c | $(BUILD_DIR)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<
